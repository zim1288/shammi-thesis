# ESP32 Home Patient Monitoring System - Production Apache / cPanel Configuration
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP in FastCGI / Apache environments
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Prevent direct access to backend internal storage and source code
    RewriteRule ^(backend/)?data_store(/.*)?$ - [F,L,NC]
    RewriteRule ^backend/(src|config|database)(/.*)?$ - [F,L,NC]

    # Map legacy /public/ URLs to /frontend/ for zero disruption
    RewriteRule ^public/(.*)$ frontend/$1 [R=301,L,NC]

    # Clean v1 REST API Routing
    RewriteRule ^api/v1/readings/?$ backend/api/v1/readings.php [L,QSA]
    RewriteRule ^api/v1/ecg/?$ backend/api/v1/ecg.php [L,QSA]
    RewriteRule ^api/v1/blood-pressure/?$ backend/api/v1/blood_pressure.php [L,QSA]
    RewriteRule ^api/v1/latest/?$ backend/api/v1/latest.php [L,QSA]
    RewriteRule ^api/v1/history/?$ backend/api/v1/history.php [L,QSA]
    RewriteRule ^api/v1/alerts/?$ backend/api/v1/alerts.php [L,QSA]
    RewriteRule ^api/v1/device/status/?$ backend/api/v1/device_status.php [L,QSA]

    # General /api/ mapping to backend/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)\.php$ backend/api/$1.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ backend/api/$1.php [L,QSA]
</IfModule>

# Prevent direct access to sensitive file formats
<FilesMatch "\.(json|env|log|git|md|yaml|yml|sql|bak|swp)$">
    Require all denied
</FilesMatch>

# Enable CORS headers for IoT Hardware ingestion
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-CSRF-Token"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
</IfModule>

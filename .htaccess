# ESP32 Home Patient Monitoring System - Production Apache Configuration
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to backend internal storage and source code
    RewriteRule ^(backend/)?data_store(/.*)?$ - [F,L,NC]
    RewriteRule ^backend/(src|config|database)(/.*)?$ - [F,L,NC]

    # Map legacy /public/ URLs to /frontend/ for zero disruption
    RewriteRule ^public/(.*)$ frontend/$1 [R=301,L,NC]

    # Clean REST API v1 Routing
    RewriteRule ^api/v1/readings/?$ backend/api/ingest/vitals.php [L,QSA]
    RewriteRule ^api/v1/ecg/?$ backend/api/ingest/ecg_batch.php [L,QSA]
    RewriteRule ^api/v1/blood-pressure/?$ backend/api/blood_pressure/manual_entry.php [L,QSA]
    RewriteRule ^api/v1/latest/?$ backend/api/vitals/latest.php [L,QSA]
    RewriteRule ^api/v1/history/?$ backend/api/vitals/history.php [L,QSA]
    RewriteRule ^api/v1/alerts/?$ backend/api/alerts/list.php [L,QSA]
    RewriteRule ^api/v1/device/status/?$ backend/api/devices/status.php [L,QSA]

    # Fallback: Transparently route any other /api/* requests to backend/api/*
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]
</IfModule>

# Prevent direct access to sensitive file formats
<FilesMatch "\.(json|env|log|git|md|yaml|yml|sql|bak|swp)$">
    Require all denied
</FilesMatch>

# Enable CORS headers for IoT Hardware ingestion
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-CSRF-Token"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
</IfModule>

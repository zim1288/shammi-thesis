# ==============================================================================
# ESP32 Home Patient Monitoring System - Production .gitignore
# ==============================================================================

# --- AI Assistant, Chat Histories & Planning Artifacts ---
.gemini/
.system_generated/
.claude/
.cursor/
brain/
scratch/
*.plan
*.transcript
transcript*.jsonl
*private*
*chat*
*.chat
*.notes
*.draft
*.todo
*.prompt

# --- Runtime Temporary Data Stores (Auto-created on boot) ---
data_store/active_otps.json
backend/data_store/active_otps.json

# --- Hardware & Firmware Private Configs ---
firmware/**/config.h
!firmware/**/config.h.example
*.local.h

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# --- Operating System Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- IDE & Editor Specific Files ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PhpStorm, WebStorm, PyCharm)
.idea/
*.iws
*.iml

# Sublime Text & Vim
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Logs, Diagnostics & Temp Files ---
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.session
*.sqlite
*.db
coverage/
.phpunit.result.cache

# --- Testing & Scratch Scripts (Never push local debug scripts) ---
test_*.php
*_test.php
test-*.php
check_*.php
temp_*.php
tests/scratch/
tests/temp/

# --- Package Managers & Dependencies ---
vendor/
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python Cache (for MQTT Simulator) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
ENV/

# --- Local Docker Overrides ---
docker-compose.override.yml
